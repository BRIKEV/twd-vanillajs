{
  "name": "twd-vanillajs",
  "version": "0.0.0",
  "description": "TWD (Test While Developing) example: a plain vanilla JS app that loads TWD from a CDN, with no bundler.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "serve": "json-server --watch data/data.json --routes data/routes.json --port 3001",
    "dev": "sirv public --single --dev --port 3000",
    "start": "sirv public --single --port 3000",
    "serve:dev": "run-p serve dev"
  },
  "devDependencies": {
    "json-server": "^0.17.4",
    "npm-run-all": "^4.1.5",
    "sirv-cli": "^3.0.0",
    "wait-on": "^8.0.1"
  }
}
